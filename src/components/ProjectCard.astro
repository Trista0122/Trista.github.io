---
import type { CollectionEntry } from 'astro:content';
import { localizedUrl } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { slugOf } from '../lib/content';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
  delay?: number;
}
const { project, lang, delay = 0 } = Astro.props;
const { title, summary, tags, period, status } = project.data;
---

<a
  class="card project-card reveal"
  href={localizedUrl(`/projects/${slugOf(project)}/`, lang)}
  style={`--reveal-delay:${delay}s`}
>
  <div class="top">
    {period && <span class="meta">{period}</span>}
    {status && <span class="status">{status}</span>}
  </div>
  <h3 transition:name={`project-${slugOf(project)}`}>{title}</h3>
  <p>{summary}</p>
  {
    tags.length > 0 && (
      <ul class="tags">
        {tags.map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
    )
  }
</a>

<style>
  .project-card { display: flex; flex-direction: column; }
  .project-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    border-radius: var(--radius) 0 0 var(--radius);
    background: linear-gradient(var(--purple-light), var(--purple), var(--purple-deep));
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .project-card:hover::before { opacity: 1; }
  .top { display: flex; justify-content: space-between; gap: 0.5rem; align-items: center; margin-bottom: 0.3rem; }
  .status {
    font-size: 0.75rem;
    color: var(--accent);
    font-weight: 600;
    white-space: nowrap;
  }
  .tags { margin-top: auto; padding-top: 0.75rem; }
</style>
