---
import View from '../../../views/ProjectDetail.astro';
import { getProjects, slugOf } from '../../../lib/content';

export async function getStaticPaths() {
  const entries = await getProjects('en');
  return entries.map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
---

<View lang="en" project={entry} />
