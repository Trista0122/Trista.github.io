---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteCard from '../components/NoteCard.astro';
import { SITE } from '../site.config';
import { useTranslations, localizedUrl } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { getByLang, getProjects, getNotes } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const [about] = await getByLang('about', lang);
const { Content: About } = about ? await render(about) : { Content: null };
const projects = (await getProjects(lang)).slice(0, 2);
const notes = (await getNotes(lang)).slice(0, 2);

const explore = [
  { path: '/now/', key: 'nav.now', icon: '◷' },
  { path: '/projects/', key: 'nav.projects', icon: '◆' },
  { path: '/notes/', key: 'nav.notes', icon: '✎' },
  { path: '/reading/', key: 'nav.reading', icon: '❏' },
  { path: '/life/', key: 'nav.life', icon: '✦' },
] as const;
---

<BaseLayout>
  <section class="hero">
    <div class="blobs" aria-hidden="true">
      <span class="blob b1"></span>
      <span class="blob b2"></span>
      <span class="blob b3"></span>
    </div>
    <div class="container hero-inner">
      <Avatar size={112} id="hero-avatar" class="reveal" />
      <div>
        <p class="hello reveal">{t('home.hello')}</p>
        <h1 class="name reveal">{SITE.nickname}</h1>
        <p class="tagline reveal">{SITE.tagline[lang]}</p>
        <div class="cta reveal">
          <a class="btn primary" href={`mailto:${SITE.email}`}>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
            {SITE.email}
          </a>
          <a class="btn" href={SITE.github} target="_blank" rel="me noopener">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"></path></svg>
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    {
      About && (
        <section class="section reveal">
          <h2 class="section-title">{t('home.introTitle')}</h2>
          <div class="prose">
            <About />
          </div>
        </section>
      )
    }

    <section class="section reveal">
      <h2 class="section-title">{t('home.contact')}</h2>
      <ul class="contact">
        <li>
          <span class="label">{t('home.email')}</span>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
        <li>
          <span class="label">GitHub</span>
          <a href={SITE.github} target="_blank" rel="me noopener">@{SITE.githubHandle}</a>
        </li>
      </ul>
    </section>

    <section class="section">
      <h2 class="section-title reveal">{t('home.explore')}</h2>
      <ul class="explore">
        {
          explore.map((item, i) => (
            <li class="reveal" style={`--reveal-delay:${i * 0.05}s`}>
              <a class="card explore-card" href={localizedUrl(item.path, lang)}>
                <span class="icon" aria-hidden="true">{item.icon}</span>
                {t(item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      projects.length > 0 && (
        <section class="section">
          <div class="section-row reveal">
            <h2 class="section-title">{t('home.latestProjects')}</h2>
            <a href={localizedUrl('/projects/', lang)}>{t('home.viewAll')}</a>
          </div>
          <div class="grid two">
            {projects.map((p, i) => (
              <ProjectCard project={p} lang={lang} delay={i * 0.08} />
            ))}
          </div>
        </section>
      )
    }

    {
      notes.length > 0 && (
        <section class="section">
          <div class="section-row reveal">
            <h2 class="section-title">{t('home.latestNotes')}</h2>
            <a href={localizedUrl('/notes/', lang)}>{t('home.viewAll')}</a>
          </div>
          <div class="grid">
            {notes.map((n, i) => (
              <NoteCard note={n} lang={lang} delay={i * 0.08} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3.5rem, 10vw, 6.5rem) 0 clamp(2.5rem, 7vw, 4.5rem);
    isolation: isolate;
  }
  .hero-inner {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .hello { margin: 0; color: var(--text-muted); font-size: 1rem; }
  .name {
    margin: 0.1rem 0 0.4rem;
    font-size: clamp(2.4rem, 8vw, 3.6rem);
    background: linear-gradient(120deg, var(--purple-deep), var(--purple) 45%, #a78bfa);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  :global(:root[data-theme='dark']) .name {
    background-image: linear-gradient(120deg, #ddd6fe, #a78bfa 50%, var(--purple));
  }
  .tagline { margin: 0 0 1.4rem; font-size: 1.12rem; color: var(--text); }
  .cta { display: flex; flex-wrap: wrap; gap: 0.6rem; }

  /* 缓慢流动的紫色渐变光斑 */
  .blobs {
    position: absolute; inset: 0; z-index: -1; pointer-events: none; filter: blur(60px);
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent);
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }
  .blob { position: absolute; border-radius: 50%; opacity: 0.9; will-change: transform; }
  .b1 {
    width: 26rem; height: 26rem; left: -6rem; top: -8rem;
    background: radial-gradient(circle at 30% 30%, var(--blob-1), transparent 70%);
    animation: float1 22s ease-in-out infinite alternate;
  }
  .b2 {
    width: 24rem; height: 24rem; right: -6rem; top: -4rem;
    background: radial-gradient(circle at 60% 40%, var(--blob-2), transparent 70%);
    animation: float2 26s ease-in-out infinite alternate;
  }
  .b3 {
    width: 16rem; height: 16rem; left: 40%; bottom: -6rem;
    background: radial-gradient(circle, var(--blob-3), transparent 70%);
    animation: float3 30s ease-in-out infinite alternate;
  }
  @keyframes float1 {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(8rem, 3rem) scale(1.15); }
    100% { transform: translate(3rem, 6rem) scale(0.95); }
  }
  @keyframes float2 {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-7rem, 4rem) scale(0.9); }
    100% { transform: translate(-3rem, -2rem) scale(1.1); }
  }
  @keyframes float3 {
    0% { transform: translate(0, 0); }
    100% { transform: translate(-10rem, -4rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .blob { animation: none; }
  }

  .section { margin-top: 3rem; }
  .section-title { margin: 0 0 1rem; font-size: 1.3rem; }
  .section-row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .section-row a { font-size: 0.92rem; text-decoration: none; white-space: nowrap; }

  .contact { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .contact li { display: flex; gap: 1rem; align-items: baseline; flex-wrap: wrap; }
  .label {
    min-width: 4.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .explore {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  }
  .explore-card {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.85rem 1rem;
    font-weight: 600;
  }
  .icon {
    display: inline-grid; place-items: center;
    width: 2rem; height: 2rem; border-radius: 10px;
    background: linear-gradient(135deg, var(--purple-light), var(--purple));
    color: #fff; font-size: 0.95rem;
  }

  @media (max-width: 560px) {
    .hero-inner { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
    .hero-inner :global(.avatar) { width: 84px; height: 84px; }
  }
</style>
