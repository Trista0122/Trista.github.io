---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localizedUrl } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { slugOf, hasCounterpart } from '../lib/content';

interface Props {
  lang: Lang;
  project: CollectionEntry<'projects'>;
}
const { lang, project } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(project);
const { title, summary, period, role, status, tags, links } = project.data;

const slug = slugOf(project);
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const altHref = (await hasCounterpart('projects', slug, other))
  ? localizedUrl(`/projects/${slug}/`, other)
  : localizedUrl('/projects/', other);

const facts = [
  { label: t('projects.period'), value: period },
  { label: t('projects.role'), value: role },
  { label: t('projects.status'), value: status },
].filter((f) => f.value);
---

<BaseLayout title={title} description={summary} altHref={altHref}>
  <article class="container">
    <a class="back reveal" href={localizedUrl('/projects/', lang)}>{t('projects.back')}</a>
    <header class="page-head reveal">
      <span class="eyebrow">{t('projects.title')}</span>
      <h1 transition:name={`project-${slug}`}>{title}</h1>
      <p>{summary}</p>
    </header>

    <dl class="facts card reveal">
      {
        facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
      {
        tags.length > 0 && (
          <div class="full">
            <dt>{t('projects.stack')}</dt>
            <dd>
              <ul class="tags">
                {tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            </dd>
          </div>
        )
      }
      {
        links.length > 0 && (
          <div class="full">
            <dt>{t('projects.links')}</dt>
            <dd class="links">
              {links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener">
                  {l.label} ↗
                </a>
              ))}
            </dd>
          </div>
        )
      }
    </dl>

    <div class="prose project-body reveal">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .back { display: inline-block; margin-top: 2rem; font-size: 0.92rem; text-decoration: none; }
  .page-head { padding-top: 1rem; }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem 1.5rem;
    margin: 0 0 2.5rem;
  }
  .facts .full { grid-column: 1 / -1; }
  dt { font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }
  dd { margin: 0.15rem 0 0; font-weight: 600; }
  dd .tags { margin-top: 0.3rem; }
  dd .tag { font-weight: 500; }
  .links { display: flex; flex-wrap: wrap; gap: 1rem; }

  /* "问题 → 方法 → 结果 → 我学到了什么" 四段式：给 h2 加编号徽标 */
  .project-body { counter-reset: step; }
  .project-body :global(h2) {
    counter-increment: step;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border-bottom: none;
  }
  .project-body :global(h2)::before {
    content: counter(step);
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 9px;
    font-size: 0.95rem;
    color: #fff;
    background: linear-gradient(135deg, #a78bfa, var(--purple) 60%, var(--purple-deep));
  }
</style>
